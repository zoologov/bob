# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing / Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/

# Beadloom (DB is generated, not tracked)
.beadloom/beadloom.db

# MCP config (contains absolute local paths)
.mcp.json

# Data directory (separate git repo for state)
data/

# Secrets / env
.env
.env.*

# Приватные ключи GitHub App Боба (BOB-089) — никогда не в git
.secrets/
*.pem
*.key

# Local run config (may reference secrets; bob.example.yaml is the tracked template)
config/bob.yaml

# Ollama models (large binaries)
models/

# Godot build artifacts
avatar/.godot/
avatar/export/
*.import

# YOLO model weights (large binaries)
yolo*.pt

# Logs
*.log
logs/

# Frozen visual track: model weights + generated assets (regeneratable from tracked dataset)
*.safetensors
godot/assets/lora/
godot/assets/sprites/
godot/tools/.venv/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Live-test dialogue artifact (local only)
first_dialogue.txt

# Agent worktrees (BOB-063)
.claude/worktrees/
# Coding-session worktrees (coder.worktree_root, default). Since BOB-087.D the persistent
# workspace LIVES here between sessions, so it must be ignored in the repo itself — not
# only via the machine-local .git/info/exclude, which a fresh clone does not carry.
.worktrees/
# Live-test dialogue dumps (local only, BOB-063)
dialog.txt
test.txt
# Mutation testing sandbox (BOB-066 Срез 0): mutmut copies src into mutants/ per run
mutants/
.mutmut-cache

# VitePress site (BOB-arch): only build output + node deps are ignored. The
# generated content tree (`beadloom docs site`) IS committed — CI just builds
# VitePress (beadloom reindex-in-CI hits an FK issue on a clean runner). Refresh
# locally with `beadloom docs site --out site` when the graph changes.
site/.vitepress/dist/
site/.vitepress/cache/
site/node_modules/
