#!/usr/bin/env bash
# bob — лаунчер Боба: start | stop | restart | status | logs
#
# Запускает GUPPI/поллинг в фоне, подхватывает ключи из ./.env, пишет лог в
# logs/bob.log и подтверждает, что поллинг Telegram реально поднялся (а не завис
# на старте). Управление одной командой:  ./bob start | stop | restart | status | logs
#
# Copyright (c) 2026 Vladimir Zoologov. All Rights Reserved.
# SPDX-License-Identifier: BUSL-1.1
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

PY=".venv/bin/python"
# BOB-103: приложение САМО владеет рабочим логом (RotatingFileHandler по
# runtime.log_*), поэтому лаунчер БОЛЬШЕ НЕ редиректит stdout/stderr в тот же
# файл — иначе двойная запись и гонка с ротацией. Рабочий лог здесь только
# ЧИТАЕМ (маркер старта), а вывод самого процесса до настройки логгера (трейсбек
# импорта, ранний краш) уходит в отдельный маленький bootstrap-лог.
LOG="logs/bob.log"
BOOTSTRAP_LOG="logs/bootstrap.log"
PATTERN="from bob.app import main"
# Один и тот же вход, что и в app.py (main(config_path=config/bob.yaml)).
LAUNCH='from pathlib import Path; from bob.app import main; main(config_path=Path("config/bob.yaml"))'

pid() { pgrep -f "$PATTERN" || true; }

start() {
  if [ -n "$(pid)" ]; then
    echo "Боб уже запущен (pid $(pid)). Стоп/рестарт: ./bob restart"
    return 0
  fi
  if [ ! -f .env ]; then
    echo "❌ Нет ./.env с ключами (BOB_LLM__TIER1_API_KEY …). Создай его сначала."
    exit 1
  fi
  if [ ! -x "$PY" ]; then
    echo "❌ Нет venv ($PY). Сначала установи зависимости (uv sync / venv)."
    exit 1
  fi
  mkdir -p logs
  local before; before=$([ -f "$LOG" ] && wc -l < "$LOG" || echo 0)

  # Подхватываем ключи из .env (app.py сам .env НЕ грузит) и стартуем в фоне.
  # 🔴 BOB-103: вывод процесса ДО настройки логгера (ранний трейсбек импорта /
  # краш) уходит в отдельный bootstrap-лог, НЕ в рабочий $LOG — рабочим логом
  # владеет приложение (ротация), и дублировать в него нельзя.
  set -a; . ./.env; set +a
  nohup "$PY" -c "$LAUNCH" >> "$BOOTSTRAP_LOG" 2>&1 < /dev/null &
  disown

  echo "Запускаю Боба… (лог: $LOG)"
  # Ждём поллинга (маркер «AgentRuntime started») до ~20с, глядя ТОЛЬКО в новые строки.
  local i new
  for i in $(seq 1 20); do
    sleep 1
    new=$(tail -n +"$((before + 1))" "$LOG" 2>/dev/null || true)
    if printf '%s' "$new" | grep -q "AgentRuntime started"; then
      echo "✅ Боб на связи (pid $(pid)) — поллинг Telegram пошёл."
      return 0
    fi
    if [ -z "$(pid)" ]; then
      echo "❌ Процесс упал на старте. Ранний вывод (bootstrap) + рабочий лог:"
      tail -n 15 "$BOOTSTRAP_LOG" 2>/dev/null || true
      tail -n 15 "$LOG" 2>/dev/null || true
      exit 1
    fi
  done
  echo "⚠️ Стартовал (pid $(pid)), но «AgentRuntime started» не увидел за 20с — проверь: ./bob logs"
}

stop() {
  local p; p="$(pid)"
  if [ -z "$p" ]; then echo "Боб не запущен."; return 0; fi
  echo "Останавливаю Боба (pid $p)…"
  # shellcheck disable=SC2086
  kill -TERM $p 2>/dev/null || true
  local i
  for i in $(seq 1 10); do
    sleep 1
    if [ -z "$(pid)" ]; then echo "✅ Остановлен."; return 0; fi
  done
  echo "Мягко не вышел — kill -9."
  # shellcheck disable=SC2046
  kill -9 $(pid) 2>/dev/null || true
  echo "✅ Остановлен (force)."
}

status() {
  local p; p="$(pid)"
  if [ -z "$p" ]; then echo "🔴 Боб НЕ запущен."; return 0; fi
  echo "🟢 Боб запущен (pid $p)."
  local last
  last=$(grep -n "Bob GUPPI starting" "$LOG" 2>/dev/null | tail -1 | cut -d: -f1 || true)
  if [ -n "${last:-}" ] && tail -n +"$last" "$LOG" 2>/dev/null | grep -q "AgentRuntime started"; then
    echo "   поллинг: активен ✅"
  else
    echo "   поллинг: не подтверждён — проверь ./bob logs"
  fi
  echo "   лог: $LOG"
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 2; start ;;
  status)  status ;;
  logs)    exec tail -f "$LOG" ;;
  *) echo "Использование: ./bob {start|stop|restart|status|logs}"; exit 1 ;;
esac
